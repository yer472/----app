{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* 路径别名（TS 6 起 paths 直接相对 tsconfig 解析，不再需要 baseUrl） */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    /* 一个「有返回值」的 switch 漏写 case 时会静默返回 undefined，
       而这类漏写在画板里后果特别隐蔽：命中测试返回 undefined 的表现是
       「新图形选不中」，导出函数返回 undefined 的表现是
       「正文里的图少了那个图形、metadata 里却完好」。
       开了这条，编译器会直接把漏掉的路径指出来。 */
    "noImplicitReturns": true
  },
  "include": ["src"]
}
